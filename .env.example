# Environment variables for running the Docker image
#   docker run --env-file .env -p 3001:3001 <image>
# or in docker-compose:  env_file: .env
# Note: server/.env is NOT copied into the image (it is in .dockerignore) —
# all values must be injected via the container environment.

# ---------- Core ----------
NODE_ENV=production

# Server port inside the container (Dockerfile sets and EXPOSEs 3001)
PORT=3001

# Admin user password seeded when the database is created — default is 1111; change in prod
ADMIN_PASSWORD=

# ---------- SMS (Kavenegar) ----------
# API key — Kavenegar panel: My Account -> API Keys
# Without this key no SMS is sent; the verification code is instead returned in the
# API response (devCode) and shown inside the app at login — anyone can log in to
# any phone number, so set this before real users join.
KAVENEGAR_API_KEY=

# Verification template name — panel: Verification -> Define verification template
# Template text must contain %token, e.g.: "Your Olyxtest login code: %token"
# If empty, the SMS is sent as full text via sms/send (more expensive and may be filtered)
KAVENEGAR_TEMPLATE=

# Dedicated sender line — only used by the sms/send path; lookup picks the line itself
KAVENEGAR_SENDER=

# SMS code digits — Persian digits by default; set 0 for Latin digits
# (only affects sms/send; in verification templates the token is always Latin)
SMS_FA_CODE=1

# ---------- Bale Pay ----------
# Bale bot token — from @botfather in Bale; if empty, payments are disabled
BALE_BOT_TOKEN=

# Wallet payment token — from @botfather -> My Bots -> "Payments"
# For testing without real money: WALLET-TEST-1111111111111111
BALE_PROVIDER_TOKEN=WALLET-TEST-1111111111111111

# Bot username (optional — fetched via getMe if empty)
BALE_BOT_USERNAME=

# Update polling — required on local servers / no public domain.
# In production with a webhook: set to 0 and setWebhook to
#   https://<domain>/api/bale/webhook?secret=<BALE_WEBHOOK_SECRET>
BALE_POLLING=1

# Webhook secret (optional — validates requests to /api/bale/webhook)
BALE_WEBHOOK_SECRET=
