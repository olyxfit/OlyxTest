# توکن بازوی بله — از @botfather در بله
BALE_BOT_TOKEN=

# توکن پرداخت کیف‌پولی — از @botfather ← بازوهای من ← «پرداخت در بازو»
# برای تست بدون جابه‌جایی پول: WALLET-TEST-1111111111111111
BALE_PROVIDER_TOKEN=WALLET-TEST-1111111111111111

# نام کاربری بازو (اختیاری — اگر خالی باشد با getMe گرفته می‌شود)
BALE_BOT_USERNAME=

# پولینگ آپدیت‌ها — در سرور لوکال/بدون دامنه لازم است.
# در پروداکشن با وب‌هوک: مقدار 0 بگذارید و روی
#   https://<domain>/api/bale/webhook?secret=...  وب‌هوک را setWebhook کنید
BALE_POLLING=1

# راز وب‌هوک (اختیاری — برای اعتبارسنجی درخواست‌های /api/bale/webhook)
BALE_WEBHOOK_SECRET=

# ---------- پیامک (کاوه‌نگار) ----------
# کلید API — از پنل کاوه‌نگار: حساب من ← کلیدهای API
# بدون این کلید، حالت توسعه فعال است و کد فقط در لاگ سرور و پاسخ API (devCode) می‌آید
KAVENEGAR_API_KEY=

# نام الگوی اعتبارسنجی — از پنل: اعتبارسنجی ← تعریف الگوی اعتبارسنجی
# متن الگو باید شامل %token باشد، مثلاً: «کد تایید ورود به Olyxtest: %token»
# اگر خالی بماند، پیامک با متن کامل از مسیر sms/send ارسال می‌شود (گران‌تر و ممکن است فیلتر شود)
KAVENEGAR_TEMPLATE=

# خط اختصاصی ارسال — فقط در مسیر sms/send استفاده می‌شود؛ lookup خط را خودش انتخاب می‌کند
KAVENEGAR_SENDER=

# ارقام کد پیامکی — پیش‌فرض فارسی است؛ برای لاتین مقدار 0 بگذارید
# (فقط در مسیر sms/send اثر دارد؛ در الگوی اعتبارسنجی توکن همیشه لاتین می‌ماند)
SMS_FA_CODE=1
