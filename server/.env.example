# ---------- هسته ----------
# پورت سرور — پیش‌فرض ۳۰۰۱
PORT=3001

# رمز کاربر admin که هنگام ساخت دیتابیس سید می‌شود — پیش‌فرض ۱۱۱۱؛ در پروداکشن حتماً تغییر دهید
ADMIN_PASSWORD=1111

# ---------- دیتابیس ----------
# آدرس Postgres — با این متغیر همهٔ داده‌ها (کاربران، نشست‌ها، آزمون‌ها، سفارش‌ها و عکس‌های پروفایل)
# در Postgres ذخیره می‌شوند؛ در اولین اجرا داده‌های فعلی data/db.json و data/avatars منتقل می‌شوند.
# اگر خالی بماند، ذخیره‌سازی فایلی data/db.json استفاده می‌شود (مناسب تست/توسعهٔ آفلاین)
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5432/postgres

# ---------- پرداخت بله ----------
